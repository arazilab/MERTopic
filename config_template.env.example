# Core API settings
# Do not paste secrets into chat. Fill this locally in the generated project's .env
# or export OPENAI_API_KEY in the shell before running API-costing stages.
OPENAI_API_KEY=

# Workflow control
# guided: scaffold and stop at major decision points unless the user confirms running.
# auto: run confirmed stages directly when credentials and inputs are available.
MERTOPIC_RUN_MODE=guided
MERTOPIC_STOP_BEFORE_API_CALLS=true
MERTOPIC_SAMPLE_BEFORE_FULL_RUN=true

# Raw data
RAW_INPUT_PATH=data/raw/input.jsonl
RAW_ID_FIELD=id
RAW_TITLE_FIELD=title
RAW_BODY_FIELD=selftext
RAW_METADATA_FIELDS_JSON=[]

# Scoping
UNIT_OF_ANALYSIS=post
RESEARCH_GOAL=
FOCAL_CONSTRUCT=
PIPELINE_NOTES=

# Optional keyword filtering
KEYWORD_FILTER_ENABLED=true
KEYWORD_FILTER_OUTPUT_DIR=data/filtered
KEYWORD_FILTER_OUTPUT_FILENAME=filtered_candidates.jsonl
KEYWORD_FILTER_STATS_FILENAME=filtered_candidate_stats.json
KEYWORD_PATTERNS_JSON=["ai","chatgpt","chatbot"]

# Optional relevancy coding
RELEVANCY_CODING_ENABLED=true
RELEVANCY_INPUT_PATH=data/filtered/filtered_candidates.jsonl
RELEVANCY_OUTPUT_DIR=data/coded
RELEVANCY_CLASSIFICATION_FILENAME=classification_results.jsonl
RELEVANCY_POSITIVE_FILENAME=relevant_posts.jsonl
RELEVANCY_STATS_FILENAME=relevancy_stats.json
RELEVANCY_MODEL=gpt-5.4-nano
RELEVANCY_SAMPLE_SIZE=25
RELEVANCY_REQUIRE_SAMPLE_REVIEW=true
RELEVANCY_INCLUSION_CRITERIA=
RELEVANCY_EXCLUSION_CRITERIA=
RELEVANCY_PROMPT=

# Extractive summary or span extraction
SUMMARY_INPUT_PATH=data/coded/relevant_posts.jsonl
SUMMARY_OUTPUT_DIR=data/summary_embeddings/bullet
SUMMARY_POST_FILENAME=post_summaries.jsonl
SUMMARY_BULLET_PARQUET_FILENAME=summary_bullets_with_embeddings.parquet
SUMMARY_BULLET_PREVIEW_FILENAME=summary_bullets_preview.csv
SUMMARY_STATS_FILENAME=summary_stats.json
SUMMARY_MODEL=gpt-5.4-nano
SUMMARY_SAMPLE_SIZE=25
SUMMARY_REQUIRE_SAMPLE_REVIEW=true
SUMMARY_EXTRACTION_OBJECTIVE=
SUMMARY_PROMPT=
SUMMARY_RETRY_PROMPT=
SUMMARY_MAX_RETRIES=4

# Embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=100
EMBEDDING_ENCODING_FORMAT=float

# Post-level embeddings
POST_EMBEDDING_INPUT_PATH=data/summary_embeddings/bullet/post_summaries.jsonl
POST_EMBEDDING_OUTPUT_DIR=data/summary_embeddings/post
POST_EMBEDDING_PARQUET_FILENAME=post_summaries_with_embeddings.parquet
POST_EMBEDDING_PREVIEW_FILENAME=post_summaries_preview.csv
POST_EMBEDDING_STATS_FILENAME=post_embedding_stats.json
POST_EMBEDDING_MODEL=text-embedding-3-small
POST_EMBEDDING_DIMENSIONS=1536
POST_EMBEDDING_BATCH_SIZE=100
POST_EMBEDDING_ENCODING_FORMAT=float

# Topic modeling
TOPIC_MODEL_LEVEL=bullet
TOPIC_MODEL_BULLET_INPUT_PATH=data/summary_embeddings/bullet/summary_bullets_with_embeddings.parquet
TOPIC_MODEL_POST_INPUT_PATH=data/summary_embeddings/post/post_summaries_with_embeddings.parquet
TOPIC_MODEL_OUTPUT_BASE_DIR=data/topic_modeling
TOPIC_MODEL_RANDOM_SEED=42
TOPIC_MODEL_UMAP_N_NEIGHBORS=10
TOPIC_MODEL_UMAP_N_COMPONENTS=5
TOPIC_MODEL_UMAP_MIN_DIST=0.1
TOPIC_MODEL_HDBSCAN_MIN_CLUSTER_SIZE=12
TOPIC_MODEL_HDBSCAN_MIN_SAMPLES=1
TOPIC_MODEL_BERTOPIC_NR_TOPICS=auto
TOPIC_MODEL_INTERTOPIC_DISTANCE_HTML_FILENAME=intertopic_distance_map.html
TOPIC_MODEL_EXTRA_STOPWORDS=[]
TOPIC_LABELING_MODEL=gpt-4.1-nano
TOPIC_LABEL_MAX_REPRESENTATIVE_DOCS=10
TOPIC_LABEL_MAX_DOC_CHARS=280
TOPIC_LABEL_MAX_OUTPUT_TOKENS=100
TOPIC_LABEL_PROMPT_TEMPLATE=

# Analysis-tool export
ANALYSIS_EXPORT_LEVEL=bullet
ANALYSIS_EXPORT_OUTPUT_DIR=data/analysis_tools/bullet

# Optional grid search
GRID_SEARCH_ENABLED=false
GRID_SEARCH_RANDOM_SEED=42
